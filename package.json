{
  "name": "dnd-vtt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm test && npm run typecheck && npm run lint",
    "verify:server": "npm run check && npm run smoke",
    "verify": "npm run verify:server && npm run build && npm run e2e && npm run shots",
    "smoke": "node scripts/smoke.mjs",
    "spells": "tsx scripts/build-spells.ts",
    "e2e": "node scripts/e2e.mjs",
    "shots": "node scripts/check-screenshots.mjs",
    "devcheck": "node scripts/check-dev.mjs"
  },
  "engines": {
    "node": ">=18.19"
  },
  "overrides": {
    "qs": "^6.16.0",
    "express": {
      "qs": "^6.16.0"
    },
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "puppeteer-core": "^25.10.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
