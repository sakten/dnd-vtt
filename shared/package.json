{
  "name": "shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./spellsData": {
      "types": "./src/spellsData.ts",
      "import": "./src/spellsData.ts"
    },
    "./bestiaryData": {
      "types": "./src/bestiaryData.ts",
      "import": "./src/bestiaryData.ts"
    },
    "./invocationsData": {
      "types": "./src/invocationsData.ts",
      "import": "./src/invocationsData.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot --bail=1",
    "test:deploy": "vitest run --config vitest.deploy.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
